{
  "manifest_version": 3,
  "name": "PhishDetector",
  "version": "1.0",
  "description": "Detect malicious websites using a trained phishing model",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishDetector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}