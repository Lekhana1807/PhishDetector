{
  "manifest_version": 3,
  "name": "PhishGuard AI",
  "version": "1.0",
  "description": "AI-based phishing detection extension",
  "permissions": ["tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard AI"
  },
  "background": {
    "service_worker": "background.js"
  }
}